
@using Microsoft.AspNetCore.Components.Authorization
@using TodoListCore.Models
@using TodoListCore.Uses_Cases.DTO
@using TodoListWeb.Security
@inherits LayoutComponentBase

<MudThemeProvider  Theme="@_mud" IsDarkMode="@IsDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider/>
        <MudLayout>
            <MudAppBar>
                <MudIconButton
                    Icon="@(IsDarkMode ? Icons.Material.Filled.WbSunny : Icons.Material.Filled.DarkMode)"
                    Color="Color.Inherit"
                    Edge="Edge.Start"
                    OnClick="ToggleDarkMode"/>
                <MudSpacer/>
                <MudButton Color="Color.Error"
                           ButtonType="ButtonType.Button"
                           OnClick="@(() => OnExitasync())">Sair</MudButton>
            </MudAppBar>
            <MudMainContent>
                @Body
            </MudMainContent>
                <MudText Class="justify-content-between"  Align="Align.End" Typo="Typo.h5" Color="Color.Inherit">
                    Desenvolvido por João Marcelo
                    <MudSpacer/>
                    <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn"
                                   Href="https://www.linkedin.com/in/joaodev443536"
                                   Target="_blank"/>
                    <MudIconButton Icon="@Icons.Custom.Brands.GitHub"
                                   Href="https://github.com/JoaoDev465"
                                  />
                </MudText>
        </MudLayout>
<MudSnackbarProvider/>

@code
{
    [Inject] NavigationManager _navigationManager { get; set; } = null;
    [Inject] JwtSecurityProvider _provider { get; set; } = null;
    [Inject] ISnackbar _snackbar { get; set; } = null;

    public async Task OnExitasync()
    {
        try
        {
            await _provider.MarkUserAuthLoggedOut();
            _navigationManager.NavigateTo("/register");
            _snackbar.Add("deslogado com sucesso", Severity.Success);
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            throw;
        }
    }

    private MudTheme _mud = Configurations.LightTheme;
    private bool IsDarkMode = false;
    void ToggleDarkMode()
    {
        if (IsDarkMode)
        {
            _mud = Configurations.LightTheme;
            IsDarkMode = false;
        }
        else
        {
            _mud = Configurations.DarkTheme;
            IsDarkMode = true;
        }
    }
}
