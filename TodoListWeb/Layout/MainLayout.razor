
@using Microsoft.AspNetCore.Components.Authorization
@using TodoListCore.Models
@using TodoListCore.Uses_Cases.DTO
@using TodoListWeb.Security
@inherits LayoutComponentBase

<MudThemeProvider/>
<MudPopoverProvider/>
<MudDialogProvider/>
<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar>
                <MudSpacer/>
                <MudButton Color="Color.Error"
                           ButtonType="ButtonType.Button"
                           OnClick="@(() => OnExitasync() )">Sair</MudButton>
            </MudAppBar>
            <MudMainContent>
                @Body
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <Login/>
    </NotAuthorized>
</AuthorizeView>
<MudSnackbarProvider/>

@code
{
    [Inject] NavigationManager _navigationManager { get; set; } = null;
    [Inject] JwtSecurityProvider _provider { get; set; } = null;
    [Inject] ISnackbar _snackbar { get; set; } = null;

    public async Task OnExitasync()
    {
        try
        {
            await _provider.MarkUserAuthLoggedOut();
            _navigationManager.NavigateTo("/Login");
            _snackbar.Add("deslogado com sucesso", Severity.Success);
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            throw;
        }
    }
}
