@page "criar/tarefas"
@attribute [Authorize]
<PageTitle>tarefas</PageTitle>

<MudContainer  Class="mt-8"> 
    <MudText Typo="Typo.h3" GutterBottom="true" Align="Align.Center">Criar tarefas</MudText>
    <MudText Align="Align.Center">Escreve a sua tarefa no campo abaixo</MudText>
    <MudGrid  Justify="Justify.Center"  Class="mt-8">
        <MudItem xs="12"  md="6">
            <MudCard Elevation="25" Class="d-flex justify-content-center" Style="height: 100%">
                <MudCardHeader Class="mt-7">
                    <CardHeaderContent>
                        <MudText Typo="Typo.h5" Align="Align.Center">Tarefas</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="d-flex justify-content-center  ">
                    <img  src="070f2f67-23ef-4c85-b8a4-6838c667575f.jpg"
                          width="150"/>
                </MudCardContent>
                <EditForm Model="@InputModel" OnValidSubmit="@CreateAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <MudTextField T="string"
                                  Label="Tarefa"
                                  HelperText="Digite a sua tarefa"
                                  @bind-Value="InputModel.Task"
                                  Required="true"
                                  Immediate="true" />

                    <MudTextField T="string"
                                  Label="Descrição"
                                  HelperText="Descrição da tarefa"
                                  @bind-Value="InputModel.DescriptionOfTask" />

                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary">Criar</MudButton>
                </EditForm>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>