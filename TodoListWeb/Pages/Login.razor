@page "/Login"
@using Blazor.Heroicons.Solid
@inherits  LoginBehind


<PageTitle>Login</PageTitle>


<MudGrid Justify="Justify.Center" Class="align-content-center ">
    <MudItem xs="12"  md="4" sm="6" >
        <MudPaper  Class=" mt-15 mb-10 mx-5" Style="min-height: auto">
            <div class="d-flex align-content-center justify-content-center">
                <h5>Login</h5>
            </div>
            <div class="d-flex justify-content-center">
                <Heroicon Name="UserIcon" Type="HeroiconType.Solid" style="width: 200px"/>
            </div>
            <EditForm Model="@InputModel" OnValidSubmit="OnValidSubmitAsync">
                <DataAnnotationsValidator/>
                <MudTextField
                    T="string"
                    Label="E-mail"
                    HelperText="campo obrigatório"
                    @bind-Value="InputModel.UserEmail"
                    Style="width: 50%"
                    InputType="InputType.Email"/>
                <MudTextField
                    T="string"
                    Label="Senha"
                    HelperText="campo obrigatório"
                    @bind-Value="InputModel.UserPassword" For="@(() => InputModel.UserPassword)"
                    Style="width: 50%"
                    InputType="@(Show ? InputType.Text : InputType.Password)"
                    Adornment="Adornment.End"
                    AdornmentIcon="@(Show
                                       ? Icons.Material.Filled.Visibility
                                       : Icons.Material.Filled.VisibilityOff)"
                    AdornmentColor="Color.Dark"
                    OnAdornmentClick="ShowPassword"/>
                <div class="d-flex mt-8">
                    @if (Isbusy)
                    {
                        <MudProgressCircular Color="Color.Info" Indeterminate="true"/>
                    }
                    else
                    {
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Entrar</MudButton>
                        <MudSpacer/>
                        <MudButton OnClick="@(() => _manager.NavigateTo("/register"))">Cadastrar</MudButton>
                    }

                </div>
            </EditForm>
        </MudPaper>
    </MudItem>
</MudGrid>

@code{

    [Inject] NavigationManager _manager { get; set; } = null;

}